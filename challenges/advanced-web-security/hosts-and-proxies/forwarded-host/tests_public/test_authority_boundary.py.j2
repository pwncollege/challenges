#!/usr/bin/env python3

import atexit
import http.server
import queue
import socket
import subprocess
import threading
import time

import requests


captured_paths = queue.Queue()


class CaptureHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        captured_paths.put(self.path)
        self.send_response(200)
        self.end_headers()

    def log_message(self, format, *args):
        pass


capture_server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), CaptureHandler)
threading.Thread(target=capture_server.serve_forever, daemon=True).start()
atexit.register(capture_server.shutdown)

subprocess.Popen(["/challenge/server"])

session = requests.Session()
session.trust_env = False
session.headers["Host"] = "challenge.localhost"
base_url = "http://127.0.0.1"

for _ in range(200):
    try:
        response = session.get(base_url, timeout=0.25)
        if response.status_code == 200:
            break
    except requests.RequestException:
        time.sleep(0.1)
else:
    raise AssertionError("server did not become ready in time")

capture_authority = f"challenge.localhost:{capture_server.server_port}"
response = session.post(
    base_url + "/request-reset",
    headers={"Host": capture_authority},
    data={"username": "admin"},
)
response.raise_for_status()
subprocess.run(["/challenge/victim"], check=True)
assert captured_paths.empty()

body = b"username=admin"
request = (
    b"POST http://challenge.localhost/request-reset HTTP/1.1\r\n"
    + f"Host: 127.0.0.1:{capture_server.server_port}\r\n".encode()
    + b"Content-Type: application/x-www-form-urlencoded\r\n"
    + f"Content-Length: {len(body)}\r\n".encode()
    + b"Connection: close\r\n\r\n"
    + body
)
with socket.create_connection(("127.0.0.1", 80), timeout=2) as connection:
    connection.sendall(request)
    response = connection.recv(4096)
assert response.startswith(b"HTTP/1.1 200")

subprocess.run(["/challenge/victim"], check=True)
assert captured_paths.empty()
