#!/usr/bin/exec-suid --real -- /bin/bash -p

as_hacker() {
    sudo -u hacker -- "$@"
}

list_tmux_sessions() {
    as_hacker timeout 1 tmux list-sessions -F '#{session_id} #{session_attached}' 2>/dev/null || true
}

TMUX_SESSION=
TMUX_LIST=
for _ in {1..20}; do
    TMUX_LIST=$(list_tmux_sessions)
    TMUX_SESSION=$(awk '$2 == 0 { print $1; exit }' <<<"$TMUX_LIST")
    [ -n "$TMUX_SESSION" ] && break
    sleep 0.1
done

if [ -z "$TMUX_SESSION" ]; then
    if [ -n "$TMUX_LIST" ]; then
        echo "Your tmux session is still attached!"
        echo ""
        echo "You need to detach from your tmux session first."
        echo "Press Ctrl-B then d to detach."
        exit 1
    fi

    echo "No detached tmux session found!"
    echo ""
    echo "You need to:"
    echo "1. Launch tmux with: tmux"
    echo "2. Detach from it with: Ctrl-B then d"
    echo "3. Then run this program again"
    exit 1
fi

FLAG_DATA=$(base64 --wrap=0 /flag) || {
    echo "Could not read the flag. Please restart the challenge and try again."
    exit 1
}
FLAG_COMMAND="printf '%s' '$FLAG_DATA' | base64 --decode"

echo "Found detached tmux session: $TMUX_SESSION"
echo "Sending flag to your tmux session..."

if ! as_hacker timeout 3 tmux send-keys -t "$TMUX_SESSION" -l "$FLAG_COMMAND" ||
    ! as_hacker timeout 3 tmux send-keys -t "$TMUX_SESSION" Enter; then
    echo "Could not send the flag to that session."
    echo "The session may have changed. Make sure it is detached, then run /challenge/run again."
    exit 1
fi

echo ""
echo "Flag sent! Now reattach to your tmux session with:"
printf "  tmux attach-session -t '%s'\n" "$TMUX_SESSION"
echo ""
echo "You'll find the flag waiting for you there!"
