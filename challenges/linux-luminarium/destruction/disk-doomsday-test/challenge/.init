#!/bin/bash
set -e

describe_mount()
{
    printf "%s namespace=%s " "$1" "$(readlink /proc/self/ns/mnt)"
    findmnt -n -o TARGET,SOURCE,FSTYPE,OPTIONS -T /home/hacker
}

describe_mount before > /run/disk-doomsday-mount
mount -t tmpfs -o size=64M,mode=0755,nosuid,nodev tmpfs /home/hacker
chown hacker:hacker /home/hacker
describe_mount after >> /run/disk-doomsday-mount
chmod 0444 /run/disk-doomsday-mount
