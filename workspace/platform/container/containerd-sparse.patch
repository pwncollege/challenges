+package blockfile
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+func TestCopyFileWithSyncPreservesHoles(t *testing.T) {
+	dir := t.TempDir()
+	source, target := filepath.Join(dir, "source"), filepath.Join(dir, "target")
+	file, err := os.Create(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	const size = 256 << 20
+	payload := []byte("data at the end")
+	if _, err := file.WriteAt(payload, size-int64(len(payload))); err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	info, err := file.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Sys().(*syscall.Stat_t).Blocks*512 > size/2 {
+		t.Skip("source filesystem does not preserve holes")
+	}
+	if err := copyFileWithSync(target, source); err != nil {
+		t.Fatal(err)
+	}
+	copied, err := os.Open(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer copied.Close()
+	result, err := copied.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Size() != size || result.Sys().(*syscall.Stat_t).Blocks*512 > size/2 {
+		t.Fatalf("copy expanded holes or changed size: size=%d blocks=%d", result.Size(), result.Sys().(*syscall.Stat_t).Blocks)
+	}
+	got := make([]byte, len(payload))
+	if _, err := copied.ReadAt(got, size-int64(len(payload))); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("payload = %q", got)
+	}
+	if _, err := copied.ReadAt(got, size/2); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, make([]byte, len(got))) {
+		t.Fatal("hole contains data")
+	}
+}
