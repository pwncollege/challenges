+    // Only controlled direct-child filenames enter the descriptor. Firecracker's
+    // VMDK gate requires every extent to live beside it, including inside a jail.
+    pub(crate) async fn prepare_readonly_drive(
+        &self,
+        config: &BlockConfigModern,
+        id: u64,
+    ) -> Result<String> {
+        let mut raw = VmdkConfig::default();
+        if config.vmdk.is_none() {
+            let size = std::fs::metadata(&config.path_on_host)?.len();
+            raw.push_extent_chunked(&config.path_on_host, size.div_ceil(512));
+        }
+        let layout = config.vmdk.as_ref().unwrap_or(&raw);
+        if layout.total_sectors().filter(|size| *size > 0).is_none() {
+            return Err(anyhow!("empty or overflowing Firecracker VMDK layout"));
+        }
+        let directory = Path::new(&self.vm_path).join(ROOT);
+        let mut descriptor = String::from("# Disk DescriptorFile\nversion=1\nCID=fffffffe\nparentCID=ffffffff\ncreateType=\"twoGbMaxExtentFlat\"\n");
+        let mut paths = HashMap::new();
+        for extent in &layout.extents {
+            let metadata = std::fs::metadata(&extent.path_on_host)?;
+            let end = extent
+                .file_offset
+                .checked_add(extent.sectors)
+                .ok_or_else(|| anyhow!("VMDK extent overflow"))?;
+            if !metadata.is_file() || metadata.len() / 512 < end {
+                return Err(anyhow!("invalid VMDK extent {}", extent.path_on_host));
+            }
+            let next = paths.len();
+            let name = match paths.entry(&extent.path_on_host) {
+                std::collections::hash_map::Entry::Occupied(entry) => entry.into_mut(),
+                std::collections::hash_map::Entry::Vacant(entry) => {
+                    let name = format!("drive{id}-extent{next}");
+                    let target = directory.join(&name);
+                    // Bind individual files; never expose the host snapshot directory.
+                    mount::bind_mount_unchecked(
+                        &extent.path_on_host,
+                        target.to_str().unwrap(),
+                        true,
+                        MsFlags::MS_SLAVE,
+                    )?;
+                    entry.insert(name)
+                }
+            };
+            writeln!(
+                descriptor,
+                "RW {} FLAT \"{}\" {}",
+                extent.sectors, name, extent.file_offset
+            )?;
+        }
+        let name = format!("drive{id}.vmdk");
+        fs::write(directory.join(&name), descriptor).await?;
+        Ok(if self.jailed {
+            format!("/{name}")
+        } else {
+            directory.join(name).display().to_string()
+        })
     }
 
